# SQLite file
DB_PATH=./proof_of_done.db
PORT=8000

# Real LLM judge (Claude). Get a key at https://console.anthropic.com — check that
# page for current pricing/trial-credit terms, and check
# https://docs.claude.com/en/docs/about-claude/models for the current model id if
# the default below is stale by the time you read this.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-haiku-4-5
LLM_JUDGE=mock
# ^ 'mock' (default, $0, no key needed, deterministic heuristic judge) or 'anthropic'
#   (real Claude API call). Flip to 'anthropic' once ANTHROPIC_API_KEY is set.

# Workspace root that 'file' evidence paths are checked against — never let a claim
# reference an arbitrary path on disk.
WORKSPACE_ROOT=./workspace

# How long (seconds) a claim can sit unresolved before the sweep auto-flags it suspicious.
SLA_SECONDS=300

# How long (seconds) a 'verifying' claim can sit claimed-but-unfinished before a worker
# restart reclaims it (same pattern as the social-studio capstone's durable worker).
CLAIM_TIMEOUT_SECONDS=60

# Printed once by scripts/seed.py — the admin key gates report generation.
ADMIN_API_KEY=changeme-admin-key
